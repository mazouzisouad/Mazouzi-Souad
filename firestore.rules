rules_version = '2';

// Règles de sécurité du planning partagé.
//
// - Propriétaires (liste ci-dessous) : accès complet, toujours.
// - Autres comptes « direction / secrétariat » et moniteurs : se gèrent dans l'appli
//   (Paramètres → Accès à l'appli), sans retoucher ces règles.
// - Un moniteur ne voit que SES séances, le nom / téléphone des élèves et la liste des
//   auto-écoles et moniteurs. Il peut seulement noter présences et résultats.
//   Paiements, factures, contrats, fiches complètes et paramètres lui sont interdits.
//
// → Remplacez les e-mails d'exemple par ceux des propriétaires.
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function proprietaire() {
      return connecte() && email() in [
        'proprietaire1@exemple.fr',
        'proprietaire2@exemple.fr'
      ];
    }
    function rolesExistent() { return exists(/databases/$(database)/documents/ecole/roles); }
    function roles() { return get(/databases/$(database)/documents/ecole/roles).data; }
    function admin() { return proprietaire() || (connecte() && rolesExistent() && email() in roles().admins); }
    function moniteur() { return connecte() && rolesExistent() && email() in roles().moniteurs; }
    function monId() { return roles().moniteurIds[email()]; }

    // Direction : tout
    match /{document=**} {
      allow read, write: if admin();
    }
    // Moniteurs : le strict nécessaire pour leur planning
    match /ecole/roles {
      allow read: if moniteur();
    }
    match /ecole/public {
      allow read: if moniteur();
    }
    match /eleves_planning/{id} {
      allow read: if moniteur();
    }
    // Fiche de suivi : tous les moniteurs la lisent, chacun écrit / modifie ses propres commentaires
    match /suivi/{id} {
      allow read: if moniteur();
      allow create: if moniteur() && request.resource.data.auteur == email();
      allow update: if moniteur() && resource.data.auteur == email() && request.resource.data.auteur == email();
      allow delete: if moniteur() && resource.data.auteur == email();
    }
    // Motos : tous les moniteurs voient la flotte et peuvent dire où est une moto
    match /motos/{id} {
      allow read: if moniteur();
      allow update: if moniteur()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emplacement', 'km', 'majLe', 'majPar']);
    }
    // Pleins d'essence : chacun ajoute / corrige les siens
    match /pleins/{id} {
      allow read: if moniteur();
      allow create: if moniteur() && request.resource.data.auteur == email();
      allow update: if moniteur() && resource.data.auteur == email() && request.resource.data.auteur == email();
      allow delete: if moniteur() && resource.data.auteur == email();
    }
    // Signature à distance d'un contrat : l'élève, sans compte, ouvre SON lien (jeton secret)
    // et signe une seule fois, avant la date d'expiration. Impossible de lister les liens.
    match /signatures/{jeton} {
      allow get: if resource.data.expireLe > request.time;
      allow update: if resource.data.statut == 'attente'
        && resource.data.expireLe > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'signature', 'signataire', 'signeLe', 'appareil', 'luEtApprouve'])
        && request.resource.data.statut == 'signe'
        && request.resource.data.luEtApprouve == true
        && request.resource.data.signature is string && request.resource.data.signature.size() < 400000
        && request.resource.data.signature.matches('^data:image/png;base64,.*')
        && request.resource.data.signataire is string && request.resource.data.signataire.size() > 1 && request.resource.data.signataire.size() <= 100
        && request.resource.data.appareil is string && request.resource.data.appareil.size() <= 250
        && request.resource.data.signeLe == request.time;
    }
    match /seances/{id} {
      allow read: if moniteur() && resource.data.moniteurId == monId();
      allow update: if moniteur()
        && resource.data.moniteurId == monId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eleves'])
        && request.resource.data.eleves.size() == resource.data.eleves.size();
    }
  }
}
