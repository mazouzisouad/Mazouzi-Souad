# Variables à saisir dans Vercel > Project > Settings > Environment Variables
# (ne jamais les mettre dans le code ni sur GitHub)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # clé publique « anon » (Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # clé SECRÈTE « service_role » (serveur uniquement)
STRIPE_SECRET_KEY=sk_live_...       # sk_test_... pour les essais
STRIPE_WEBHOOK_SECRET=whsec_...     # donné par Stripe à la création du webhook
SITE_URL=https://www.votre-site.fr  # adresse publique du site, sans / final

# --- Rappels par e-mail (Brevo) ---
BREVO_API_KEY=xkeysib-...           # Brevo > Paramètres > SMTP et API > Clés API
EMAIL_EXPEDITEUR=bonjour@votre-site.fr  # adresse d'un domaine vérifié dans Brevo
EMAIL_NOM=Code Ludique
CRON_SECRET=une-longue-chaine-aleatoire # protège l'envoi quotidien (Vercel l'utilise automatiquement)

# --- Tableau de bord interne ---
ADMIN_EMAILS=vous@votre-site.fr     # adresses autorisées sur /admin, séparées par des virgules
